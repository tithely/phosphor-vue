{
  "compilerOptions": {
    "target": "es2018",
    "moduleResolution": "node",
    "baseUrl": ".",
    "declaration": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "types": [
      "vue"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "lib": [
      "esnext",
      "dom"
    ]
  },
  "include": [
    "src/**/*",
    "src/vue-shims.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
